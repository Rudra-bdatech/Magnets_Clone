# ==========================================
# MAGNETS PAYMENT GATEWAY ENVIRONMENT CONFIG
# ==========================================

# Chargebee (Domestic / India / INR Payments via Hosted Payment Pages)
# Get credentials at: https://app.chargebee.com → Settings → API Keys
# CHARGEBEE_SITE = your site name e.g. "magnets-test" (without .chargebee.com)
CHARGEBEE_SITE="your-chargebee-site-name"
CHARGEBEE_API_KEY="your_chargebee_api_key"
CHARGEBEE_ITEM_PRICE_ID_INR="pro-monthly-INR"
CHARGEBEE_WEBHOOK_USERNAME="your_webhook_username"
CHARGEBEE_WEBHOOK_PASSWORD="your_webhook_password"

# Stripe (International / Global / USD Payments - $29/mo)
# Get credentials at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# App URL
NEXTAUTH_URL="http://localhost:3000"

# Custom domains
# Host customers should CNAME their subdomain to. Vercel issues SSL only for this target.
NEXT_PUBLIC_CNAME_TARGET="cname.vercel-dns.com"
# Optional. When set, a verified domain is attached to this Vercel project.
# Leave blank on hosts that do not use the Vercel domain API.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
