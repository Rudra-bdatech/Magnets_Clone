# Ripgrep & Agent Ignore File

# Heavy uploads & binary files
public/uploads/
*.pdf
*.docx
*.zip
*.tar.gz

# Minified and single-line vendor scripts
public/pdf.worker.min.mjs

# Build caches & lockfiles from indexing
*.tsbuildinfo
package-lock.json

# Image and media assets
public/brand/
public/fonts/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.ico
*.ttf
*.woff
*.woff2

# Build outputs & dependencies
.next/
node_modules/
out/
build/
coverage/

# Scratch & test scripts
scratch/
scratch_*
*.pyc
__pycache__/

# Heavy AI datasets
.agents/skills/**/data/
.claude/skills/**/data/

